{
  "manifest_version": 1,
  "type": "device",
  "name": "Parkings en temps réel",
  "description": {
    "en": "Free spaces of public car parks in French cities (open data): Strasbourg, Bordeaux, Nantes…",
    "fr": "Places libres des parkings publics de villes françaises (open data) : Strasbourg, Bordeaux, Nantes…",
    "de": "Freie Plätze öffentlicher Parkhäuser französischer Städte (Open Data): Straßburg, Bordeaux…",
    "es": "Plazas libres de aparcamientos públicos de ciudades francesas (datos abiertos): Estrasburgo…"
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-parkings:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-parkings/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "Tick your cities and save: their car parks with a live count appear in the Discover tab. Add the ones you want to Gladys. No account, no key.",
        "fr": "Cochez vos villes et enregistrez : leurs parkings à comptage en direct apparaissent dans l'onglet Découverte. Ajoutez ceux qui vous intéressent à Gladys. Sans compte ni clé.",
        "de": "Kreuze deine Städte an und speichere: ihre Parkhäuser mit Live-Zählung erscheinen im Tab „Entdecken“. Füge die gewünschten zu Gladys hinzu. Kein Konto, kein Schlüssel.",
        "es": "Marque sus ciudades y guarde: sus aparcamientos con recuento en directo aparecen en la pestaña Descubrir. Añada a Gladys los que le interesen. Sin cuenta ni clave."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-parkings/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide de configuration",
            "de": "Einrichtungsanleitung",
            "es": "Guía de configuración"
          }
        }
      ]
    },
    {
      "key": "cities",
      "type": "multi_select",
      "label": {
        "en": "Cities",
        "fr": "Villes",
        "de": "Städte",
        "es": "Ciudades"
      },
      "description": {
        "en": "Car parks published live in open data. Others: see the guide.",
        "fr": "Parkings publiés en direct en open data. Autres villes : voir le guide.",
        "de": "Live als Open Data veröffentlichte Parkhäuser. Andere Städte: siehe Anleitung.",
        "es": "Aparcamientos publicados en directo en datos abiertos. Otras ciudades: vea la guía."
      },
      "options": [
        {
          "value": "strasbourg",
          "label": {
            "en": "Strasbourg",
            "fr": "Strasbourg",
            "de": "Straßburg",
            "es": "Estrasburgo"
